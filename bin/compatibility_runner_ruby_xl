#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "zip"
require "rspec"
require "rspec/core"
require_relative "../lib/xlsxrb/adapters/ruby_xl"

# Activate RubyXL drop-in compatibility mode (binds ::RubyXL and registers subpath features)
Xlsxrb::Adapters::RubyXL.activate!
$LOADED_FEATURES << "spec_helper.rb"

RSpec.configure do |c|
  c.color = true
end

require_relative "support/upstream_suite"

# Locate official rubyXL spec files
spec_dir = ENV["RUBYXL_SPEC_DIR"]

unless spec_dir && Dir.exist?(spec_dir)
  begin
    spec = Gem.loaded_specs["rubyXL"] || Gem::Specification.find_by_name("rubyXL")
    gem_spec = File.join(spec.gem_dir, "spec", "lib")
    spec_dir = gem_spec if Dir.exist?(gem_spec)
  rescue Gem::MissingSpecError
    nil
  end
end

unless spec_dir && Dir.exist?(spec_dir)
  repo_spec = File.join(UpstreamSuite.repo_path("rubyXL"), "spec", "lib")
  spec_dir = repo_spec if Dir.exist?(repo_spec)
end

unless spec_dir && Dir.exist?(spec_dir)
  msg = "rubyXL upstream spec suite not found in rubyXL gem or upstream repository."
  if ENV["CI"] || ENV["XLSXRB_REQUIRE_UPSTREAM"]
    abort "Error: #{msg} (required by CI/XLSXRB_REQUIRE_UPSTREAM)"
  else
    warn "Skipping rubyXL official spec suite: #{msg}"
    exit 0
  end
end

spec_paths = Dir.glob(File.join(spec_dir, "**/*_spec.rb"))
results = {}

puts "=================================================="
puts "Running official rubyXL spec suite (#{spec_dir})"
puts "Target: Xlsxrb::Adapters::RubyXL"
puts "=================================================="

spec_paths.each do |path|
  file = File.basename(path)

  # Reset RSpec world for each file to isolate examples
  RSpec.reset

  RSpec::Core::Runner.run([path, "--format", "progress"])
  world = RSpec.world
  examples = world.all_examples
  failed = examples.select { |e| e.execution_result.status == :failed }
  passed = examples.select { |e| e.execution_result.status == :passed }
  pending = examples.select { |e| e.execution_result.status == :pending }

  results[file] = {
    total: examples.size,
    passed: passed.size,
    failed: failed.size,
    pending: pending.size
  }
end

puts "\n\n"
puts "=================================================="
puts "SUMMARY OF OFFICIAL RUBYXL RSPEC SUITE RUN"
puts "=================================================="
total_all = 0
passed_all = 0
failed_all = 0

puts "File                   |  Total |   Pass |   Fail |  Pass %"
puts "-" * 55
results.each do |file, res|
  total_all += res[:total]
  passed_all += res[:passed]
  failed_all += res[:failed]
  pct = res[:total].positive? ? (res[:passed].to_f / res[:total] * 100).round(1) : 0
  puts format("%<file>-22s | %<total>6d | %<pass>6d | %<fail>6d | %<pct>6.1f%%",
              file: file, total: res[:total], pass: res[:passed], fail: res[:failed], pct: pct)
end
puts "-" * 55
pct_all = total_all.positive? ? (passed_all.to_f / total_all * 100).round(1) : 0
puts format("%<file>-22s | %<total>6d | %<pass>6d | %<fail>6d | %<pct>6.1f%%",
            file: "TOTAL", total: total_all, pass: passed_all, fail: failed_all, pct: pct_all)
puts "=================================================="

exit(failed_all.zero? ? 0 : 1)
