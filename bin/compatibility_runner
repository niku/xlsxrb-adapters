#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rbconfig"

target = (ARGV[0] || "all").downcase

ruby = RbConfig.ruby
dir = __dir__

ruby_xl_runner = File.join(dir, "compatibility_runner_ruby_xl")
caxlsx_runner = File.join(dir, "compatibility_runner_caxlsx")
roo_runner = File.join(dir, "compatibility_runner_roo")
xsv_runner = File.join(dir, "compatibility_runner_xsv")
creek_runner = File.join(dir, "compatibility_runner_creek")
fast_excel_runner = File.join(dir, "compatibility_runner_fast_excel")
write_xlsx_runner = File.join(dir, "compatibility_runner_write_xlsx")
xlsxtream_runner = File.join(dir, "compatibility_runner_xlsxtream")
simple_xlsx_reader_runner = File.join(dir, "compatibility_runner_simple_xlsx_reader")

exit_codes = []

case target
when "ruby_xl", "rubyxl"
  exit_codes << (system(ruby, ruby_xl_runner) ? 0 : 1)
when "caxlsx", "axlsx"
  exit_codes << (system(ruby, caxlsx_runner) ? 0 : 1)
when "roo"
  exit_codes << (system(ruby, roo_runner) ? 0 : 1)
when "xsv"
  exit_codes << (system(ruby, xsv_runner) ? 0 : 1)
when "creek"
  exit_codes << (system(ruby, creek_runner) ? 0 : 1)
when "fast_excel", "fastexcel"
  exit_codes << (system(ruby, fast_excel_runner) ? 0 : 1)
when "write_xlsx", "writexlsx"
  exit_codes << (system(ruby, write_xlsx_runner) ? 0 : 1)
when "xlsxtream"
  exit_codes << (system(ruby, xlsxtream_runner) ? 0 : 1)
when "simple_xlsx_reader", "simplexlsxreader"
  exit_codes << (system(ruby, simple_xlsx_reader_runner) ? 0 : 1)
when "all"
  puts ">>> Running RubyXL compatibility suite..."
  exit_codes << (system(ruby, ruby_xl_runner) ? 0 : 1)
  puts "\n>>> Running Caxlsx compatibility suite..."
  exit_codes << (system(ruby, caxlsx_runner) ? 0 : 1)
  puts "\n>>> Running Roo compatibility suite..."
  exit_codes << (system(ruby, roo_runner) ? 0 : 1)
  puts "\n>>> Running Xsv compatibility suite..."
  exit_codes << (system(ruby, xsv_runner) ? 0 : 1)
  puts "\n>>> Running Creek compatibility suite..."
  exit_codes << (system(ruby, creek_runner) ? 0 : 1)
  puts "\n>>> Running FastExcel compatibility suite..."
  exit_codes << (system(ruby, fast_excel_runner) ? 0 : 1)
  puts "\n>>> Running WriteXLSX compatibility suite..."
  exit_codes << (system(ruby, write_xlsx_runner) ? 0 : 1)
  puts "\n>>> Running Xlsxtream compatibility suite..."
  exit_codes << (system(ruby, xlsxtream_runner) ? 0 : 1)
  puts "\n>>> Running SimpleXlsxReader compatibility suite..."
  exit_codes << (system(ruby, simple_xlsx_reader_runner) ? 0 : 1)
else
  warn "Unknown compatibility target: #{target}. Valid targets: all, ruby_xl, caxlsx, roo, xsv, creek, fast_excel, write_xlsx, xlsxtream, simple_xlsx_reader"
  exit 1
end

exit(exit_codes.all?(&:zero?) ? 0 : 1)
