        def d_lbls: () -> DLbls

        # @return [Relationship]
        # : () -> Relationship
        def relationship: () -> Relationship

        # @return [Integer]
        # : () -> Integer
        def index: () -> Integer

        # @return [String]
        # : () -> String
        def pn: () -> String

        # @param v [String, Cell]
        # @return [void]
        # : (String | Cell v) -> void
        def title=: (String | Cell v) -> void

        # @param v [String]
        # @return [void]
        # : (String v) -> void
        def title_size=: (String v) -> void

        # @param v [Boolean]
        # @return [Boolean]
        # : (bool v) -> bool
        def show_legend=: (bool v) -> bool

        # @param v [Symbol]
        # @return [Symbol]
        # : (Symbol v) -> Symbol
        def display_blanks_as=: (Symbol v) -> Symbol

        # @param v [Integer]
        # @return [void]
        # : (Integer v) -> void
        def style=: (Integer v) -> void

        # @param v [Symbol]
        # @return [Symbol]
        # : (Symbol v) -> Symbol
        def legend_position=: (Symbol v) -> Symbol

        # @return [Marker]
        # : () -> Marker
        def to: () -> Marker

        # @return [Marker]
        # : () -> Marker
        def from: () -> Marker

        # @param options [Hash{Symbol => untyped}]
        # @return [Series]
        # : (?Hash[Symbol, untyped] options) -> Series
        def add_series: (?Hash[Symbol, untyped] options) -> Series

        # @param v [String]
        # @return [void]
        # : (String v) -> void
        def bg_color=: (String v) -> void

        # @param v [Boolean]
        # @return [Boolean]
        # : (bool v) -> bool
        def plot_visible_only=: (bool v) -> bool

        # @param v [Boolean]
        # @return [Boolean]
        # : (bool v) -> bool
        def rounded_corners=: (bool v) -> bool

        # @param x [Integer, String, Cell, Array[Integer]]
        # @param y [Integer]
        # @return [Marker]
        # : (?Integer | String | Cell | Array[Integer] x, ?Integer y) -> Marker
        def start_at: (?Integer | String | Cell | Array[Integer] x, ?Integer y) -> Marker

        # @param x [Integer]
        # @param y [Integer]
        # @return [Marker]
        # : (?Integer x, ?Integer y) -> Marker
        def end_at: (?Integer x, ?Integer y) -> Marker

        # @param v [View3D]
        # @return [void]
        # : (View3D v) -> void
        def view_3D=: (View3D v) -> void

        alias view3D= view_3D=

        # @param str [String]
        # @return [String]
        # : (?String str) ?{ () -> void } -> String
        def to_xml_string: (?String str) ?{ () -> void } -> String

        # Converts chart settings to an options hash compatible with xlsxrb ChartBuilder / Writer.
        #
        # @return [Hash{Symbol => untyped}]
        # : () -> Hash[Symbol, untyped]
        def to_chart_options: () -> Hash[Symbol, untyped]

        alias to_hash to_chart_options
      end

      # Bar chart.
      class BarChart < Chart
        # @return [CatAxis]
        # : () -> CatAxis
        def cat_axis: () -> CatAxis

        alias catAxis cat_axis

        # @return [ValAxis]
        # : () -> ValAxis
        def val_axis: () -> ValAxis

        alias valAxis val_axis

        # @return [Symbol]
        # : () -> Symbol
        def bar_dir: () -> Symbol

        alias barDir bar_dir

        # @return [Integer]
        # : () -> Integer
        def gap_width: () -> Integer

        alias gapWidth gap_width

        # @return [Symbol]
        # : () -> Symbol
        def grouping: () -> Symbol

        # @return [Integer]
        # : () -> Integer
        def overlap: () -> Integer

        # @return [Symbol]
        # : () -> Symbol
        def shape: () -> Symbol

        # @param frame [GraphicFrame]
        # @param options [Hash{Symbol => untyped}]
        # : (GraphicFrame frame, ?Hash[Symbol, untyped] options) -> void
        def initialize: (GraphicFrame frame, ?Hash[Symbol, untyped] options) -> void

        # @param v [Symbol]
        # @return [Symbol]
        # : (Symbol v) -> Symbol
        def bar_dir=: (Symbol v) -> Symbol

        alias barDir= bar_dir=

        # @param v [Symbol]
        # @return [Symbol]
        # : (Symbol v) -> Symbol
        def grouping=: (Symbol v) -> Symbol

        # @param v [Integer]
        # @return [Integer]
        # : (Integer v) -> Integer
        def gap_width=: (Integer v) -> Integer

        alias gapWidth= gap_width=

        # @param v [Integer]
        # @return [Integer]
        # : (Integer v) -> Integer
        def overlap=: (Integer v) -> Integer

        # @param v [Symbol]
        # @return [Symbol]
        # : (Symbol v) -> Symbol
        def shape=: (Symbol v) -> Symbol

        # @return [Axes]
        # : () -> Axes
        def axes: () -> Axes

        # @param str [String]
        # @return [String]
        # : (?String str) -> String
        def to_xml_string: (?String str) -> String
      end

      # 3D Bar chart.
